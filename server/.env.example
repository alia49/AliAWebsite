# Copy to server/.env for local development (npm start / npm run dev load it automatically).
# On a host (Render, Railway, Fly...) set these in the dashboard instead. All are optional.

# Port to listen on. Most hosts inject PORT themselves.
PORT=8787

# Comma-separated list of browser origins allowed to call the API (exact match, no path).
# Use * to allow any origin (not recommended in production).
ALLOWED_ORIGINS=http://localhost:3000,https://alia49.github.io

# SQLite database file. Relative paths resolve against server/. On a host, point this at a
# persistent disk/volume (e.g. /data/site.db) or chat history resets on every deploy.
DB_PATH=./data/site.db

# Set when running behind a reverse proxy/load balancer so per-IP rate limits see the real
# visitor IP: 1 (one proxy hop, right for Render/Railway/Fly), true, or a subnet list.
# IPs are only ever used in memory for rate limiting; they are never stored or logged.
TRUST_PROXY=

# Secret used to hash visitor ids (X-Client-Id). If empty, one is generated on first run and
# stored in the database. Changing it later detaches old chat messages from their authors.
CLIENT_ID_SALT=

# Content used to ground /api/ask. Relative paths resolve against server/.
PROFILE_PATH=../src/content/profile.json

# Enables POST /api/ask. Without it /api/ask returns 503 ask_disabled and /api/health reports ask:false.
ANTHROPIC_API_KEY=

# Model for /api/ask. Default: claude-opus-5. Cheaper options: claude-sonnet-5, claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5

# Maximum /api/ask questions per UTC day across all visitors (a spend cap). 0 disables asking.
ASK_DAILY_LIMIT=300
